{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "verbatimModuleSyntax": false,
    "outDir": "dist/cjs",
    "declaration": false,
    "declarationMap": false,
    "noEmit": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts"]
}
